{
  "name": "glancecard",
  "version": "0.9.0",
  "description": "Your GitHub profile and repositories, at a glance: daily SVG cards for your READMEs, rendered by GitHub Actions.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./src/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./types/setup.d.ts",
        "default": "./site/editor.js"
      },
      "require": {
        "types": "./types/setup.d.cts",
        "default": "./site/editor.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "setup": [
        "./types/setup.d.ts"
      ]
    }
  },
  "bin": {
    "glancecard": "src/cli.js"
  },
  "files": [
    "src",
    "types",
    "site/editor.js",
    "action.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "golden": "node scripts/update-golden.js",
    "preview": "node scripts/preview.js"
  },
  "keywords": [
    "github-actions",
    "readme",
    "svg",
    "github-stats",
    "profile-readme",
    "repository",
    "dashboard",
    "svg-cards",
    "library"
  ],
  "author": "Giovambattista Fazioli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfazioli/glancecard.git"
  },
  "homepage": "https://github.com/gfazioli/glancecard#readme",
  "bugs": "https://github.com/gfazioli/glancecard/issues"
}
